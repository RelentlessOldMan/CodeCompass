<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net10 because this project references CodeCompass.Mcp (net10) - a net8 project can't consume a net10
         assembly. Runs the net8 Core/Semantics libraries fine on the net10 test runtime. -->
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CodeCompass.Core\CodeCompass.Core.csproj" />
    <ProjectReference Include="..\..\src\CodeCompass.Mcp\CodeCompass.Mcp.csproj" />
    <ProjectReference Include="..\..\src\CodeCompass.Semantics\CodeCompass.Semantics.csproj" />
    <ProjectReference Include="..\..\src\CodeCompass.Bench\CodeCompass.Bench.csproj" />
  </ItemGroup>

</Project>
