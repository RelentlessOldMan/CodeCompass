<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\CodeCompass.Core\CodeCompass.Core.csproj" />
    <ProjectReference Include="..\CodeCompass.Semantics\CodeCompass.Semantics.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CodeCompass.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- net10: the MCP SDK (ModelContextProtocol / Microsoft.Extensions.AI / Hosting) depends on the .NET 10
         base-library family (System.Text.Json 10, System.Text.Encodings.Web 10, ...). A net8 self-contained
         publish ships the .NET 8 copies of those in-box assemblies and the server crashes on launch, so the
         executable must target net10 (its runtime pack carries the matching versions). Core/Semantics stay
         net8 and are consumed fine by this net10 exe. -->
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Disable Dynamic PGO: on net10 it makes the clang C/C++ find_references hot loop ~2.5x slower (CPU)
         than net8, isolated to Tiered PGO by A/B (see CodeCompass.Cli.csproj). Bakes
         System.Runtime.TieredPGO:false into runtimeconfig.json so the published server needs no env var. -->
    <TieredPGO>false</TieredPGO>
  </PropertyGroup>

</Project>
